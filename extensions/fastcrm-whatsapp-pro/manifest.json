{
  "manifest_version": 3,
  "name": "FastCRM WhatsApp Pro",
  "version": "0.1.1",
  "description": "Painel lateral do FastCRM para trabalho assistido junto do WhatsApp Web. Prova de conceito — sem envio automático, sem leitura de conversas.",
  "default_locale": "pt_PT",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [],
  "action": {
    "default_title": "Abrir painel FastCRM WhatsApp Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
