{
  "manifest_version": 3,
  "name": "FastCRM WhatsApp Pro",
  "version": "0.7.2",
  "key": "",
  "description": "Painel lateral do FastCRM junto do WhatsApp Web. Guarda automaticamente no CRM o texto da conversa aberta no WhatsApp Web. Nunca envia mensagens.",
  "default_locale": "pt_PT",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "identity",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://eumnfkccyvlyoyjchiwe.supabase.co/*",
    "https://web.whatsapp.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src https://eumnfkccyvlyoyjchiwe.supabase.co; form-action 'none'"
  },
  "action": {
    "default_title": "Abrir painel FastCRM WhatsApp Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
